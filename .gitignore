# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/
env/

# Environment / secrets
.env
*.env

# Claude bridge mTLS certs (client identity staged into the sandbox at deploy time;
# also the setup script's default cert dir if run against a source checkout)
.bridge/

# In-sandbox uvicorn supervisor, generated by scripts/victoria-watchdog.sh into the
# staged clone (which is itself a checkout, so it would otherwise show as untracked)
.victoria-run.sh

# Data & models (large, local only)
data/
models/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# MCP config (may contain server secrets)
mcp.json

# Imported skills (pulled from other repos) — keep only your curated skills.
# Delete this line if you want to version imported skills too.
skills/imported/
